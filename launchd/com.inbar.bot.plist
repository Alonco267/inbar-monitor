<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Telegram bot daemon — runs forever, restarts on crash -->
  <key>Label</key>
  <string>com.inbar.bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VENV_PYTHON__</string>
    <string>__SCRIPT_PATH__</string>
    <string>--bot</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORK_DIR__</string>

  <!-- Restart automatically if the process exits for any reason -->
  <key>KeepAlive</key>
  <true/>

  <!-- Wait 10 s before restarting after a crash -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__WORK_DIR__/logs/bot.log</string>

  <key>StandardErrorPath</key>
  <string>__WORK_DIR__/logs/bot_error.log</string>

  <!-- Flush Python stdout/stderr immediately to log files -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Start at login -->
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
